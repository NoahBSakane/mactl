{
  "PreToolUse": [
    { "matcher": ".*",
      "hooks": [ { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh agy-job-guard.sh PreToolUse", "timeout": 15 } ] },
    { "matcher": "run_command",
      "hooks": [
        { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh danger-guard.sh PreToolUse", "timeout": 15 },
        { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh secret-scan.sh PreToolUse", "timeout": 15 },
        { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh gate.sh PreToolUse", "timeout": 15 }
      ] },
    { "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
      "hooks": [ { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh gate.sh PreToolUse", "timeout": 15 } ] }
  ],
  "PostToolUse": [
    { "matcher": "run_command",
      "hooks": [ { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh logger.sh PostToolUse", "timeout": 15 } ] },
    { "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
      "hooks": [
        { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh md-lint.sh PostToolUse", "timeout": 100 },
        { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh handoff-exclude-hook.sh PostToolUse", "timeout": 15 }
      ] }
  ],
  "PreInvocation": [
    { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh pending PreInvocation", "timeout": 15 }
  ],
  "Stop": [
    { "type": "command", "command": "$HOME/.agents/hooks/agy-adapter.sh ofuro-guard.sh Stop", "timeout": 15 }
  ]
}
